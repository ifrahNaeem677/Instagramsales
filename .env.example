# ---- Server ----
PORT=3000

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low = fast and cheap, good for chat. Raise to medium/high if answers feel weak.
CLAUDE_EFFORT=low

# ---- Meta app (developers.facebook.com) ----
# Any random string you choose; paste the same value in the Meta webhook settings.
META_VERIFY_TOKEN=choose-a-long-random-string
# App Dashboard -> App settings -> Basic -> App secret (used to verify webhook signatures)
META_APP_SECRET=
# ID of the Facebook Page linked to your Instagram Business account
FB_PAGE_ID=
# Your Instagram Business account ID (so the bot ignores its own messages)
IG_ACCOUNT_ID=
# Long-lived Page access token with instagram_basic, instagram_manage_messages,
# instagram_manage_comments, pages_manage_metadata permissions
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0

# ---- Comment-to-DM ----
# When someone comments one of these words on your posts, the bot DMs them privately.
COMMENT_KEYWORDS=price,info,order,dm,details,how much

# ---- WhatsApp Cloud API (order notifications to you) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your personal WhatsApp number that receives orders, international format, digits only
OWNER_WHATSAPP_NUMBER=923001234567
# Optional: approved template name with ONE body variable {{1}} (see README).
# Leave empty to send plain text (works only if you messaged the business number in the last 24h).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
